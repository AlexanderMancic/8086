{
    "$schema": "https://raw.githubusercontent.com/mfussenegger/dapconfig-schema/master/dapconfig-schema.json",
    "version": "0.2.0",
    "configurations": [
			{
            "name": "Debug diff",
            "type": "codelldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/disassembler",
            "args": [
                "${workspaceFolder}/build/diff.bin",
                "${workspaceFolder}/build/diff_output.asm"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}
